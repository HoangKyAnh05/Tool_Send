# Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID của bạn (Lấy từ @userinfobot hoặc khi bạn gửi tin nhắn bot sẽ hiện ID)
# Cho phép nhiều ID cách nhau bằng dấu phẩy: 123456789,987654321
ALLOWED_USER_IDS=your_telegram_user_id_here

# Tên tiêu đề cửa sổ Antigravity để Bot tự động tìm và focus
WINDOW_TITLE_KEYWORD=Antigravity

# Độ trễ (giây) sau khi dán nội dung trước khi bấm Enter
PASTE_DELAY=0.3
